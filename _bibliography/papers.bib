@inproceedings{deng2025stcmix,
  title = {Shift Time Channel Mix (STCMix): Spatial Information Fusion for Spiking Neural Networks},
  author = {Deng, Xin and You, Tianhao and Liu, Yihan},
  booktitle = {2025 International Conference on Machine Intelligence and Nature-Inspired Computing (MIND)},
  year = {2025},
  abbr = {MIND},
  selected = {true},
  preview = {Poster-STCMix.png},
  doi = {10.1109/MIND67540.2025.11351592},
  html = {https://ieeexplore.ieee.org/document/11351592},
  abstract = {Spiking Neural Networks (SNNs) biologically model the neurons and use the discrete spikes for information representation. Effective interaction between temporal and channel dimensions is crucial for SNNs, where sparse and localized features dominate. This work proposes the Shift Time Channel Mix (STCMix) module, that enhances the spatial awareness across time and fuses the spatial redundancy across channels through explicit operations. Unlike the attention-based methods, STCMix introduces no the learned weights and incurs minimal overhead, making it suitable for energy-constrained SNN deployments. Experiments on static and neuromorphic datasets demonstrate that STCMix significantly improves SNN performance by promoting efficient spatio-temporal interaction.},
}
